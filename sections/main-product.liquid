<product-info
  id="MainProduct-{{ section.id }}"
  class=""
  data-section="{{ section.id }}"
  data-product-id="{{ product.id }}"
  data-update-url="true"
  data-url="{{ product.url }}"
>
  {{ 'section-main-product.css' | asset_url | stylesheet_tag }}
  {{ 'component-accordion.css' | asset_url | stylesheet_tag }}
  {{ 'component-price.css' | asset_url | stylesheet_tag }}
  {{ 'component-loading-overlay.css' | asset_url | stylesheet_tag }}
  {{ 'component-slider.css' | asset_url | stylesheet_tag }}

  {%- style -%}
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top_mobile }}px;
      padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
    }
    .product-media-image {
      background: {{ section.settings.media_bg_col }};
    }
    .gallery-slider--thumbnail, .lightbox-thumbnail, .stacked-thumbnails-wrapper button {
      background: {{ section.settings.media_bg_col }} !important;
    }
    {% if section.settings.thumbnail_border_opacity == 0 %}
    .gallery-slider--thumbnail img, .lightbox-thumbnail img, .stacked-thumbnails-wrapper button, .stacked-thumbnails-wrapper button.highlight-disable {
      border: 1px solid transparent;  
    }
    {% endif %}
    {% if section.settings.thumbnail_border_opacity > 0 %}
    .gallery-slider--thumbnail img, .lightbox-thumbnail img, .stacked-thumbnails-wrapper button, .stacked-thumbnails-wrapper button.highlight-disable {
      border: 1px solid rgba(var(--color-foreground-rgb),{{ section.settings.thumbnail_border_opacity | divided_by: 100.0 }});  
    }
    {% endif %}
    .gallery-slider--thumbnail.active img, .stacked-thumbnails-wrapper button.active {
      border: 1px solid rgba(var(--color-foreground-rgb),{{ section.settings.thumbnail_border_opacity_active | divided_by: 100.0 }});
    }
    .stacked-thumbnails-wrapper button.highlight-selected {
      border: 1px solid rgba(var(--color-foreground-rgb),{{ section.settings.thumbnail_border_opacity_active | divided_by: 100.0 }}) !important;
    }
    .stacked-thumbnails-wrapper.stacked-gt-style--trackbar button.highlight-selected {
      border: 0 !important;
    }
    {% if section.settings.thumbnail_border_opacity > 0 %}
    .stacked-thumbnails-wrapper button.highlight-disable {
      border: 1px solid rgba(var(--color-foreground-rgb),{{ section.settings.thumbnail_border_opacity | divided_by: 100.0 }});  
    }
    {% endif %}
    {% if section.settings.thumbnail_border_opacity == 0 %}
    .stacked-thumbnails-wrapper button.highlight-disable {
      border: 1px solid transparent;  
    }
    {% endif %}
    .modal-gallery-fg-fg-body .lightbox-thumbnail-active img {
      border: 1px solid rgba(var(--color-foreground-rgb),{{ section.settings.thumbnail_border_opacity_active | divided_by: 100.0 }});
    }
    .modal-gallery-fg-fg-01 .lightbox-thumbnail-active img {
      border: 1px solid rgba(var(--color-accent-one-rgb),{{ section.settings.thumbnail_border_opacity_active | divided_by: 100.0 }});
    }
    .modal-gallery-fg-fg-02 .lightbox-thumbnail-active img {
      border: 1px solid rgba(var(--color-accent-two-rgb),{{ section.settings.thumbnail_border_opacity_active | divided_by: 100.0 }});
    }
    .modal-gallery-fg-fg-03 .lightbox-thumbnail-active img {
      border: 1px solid rgba(var(--color-accent-three-rgb),{{ section.settings.thumbnail_border_opacity_active | divided_by: 100.0 }});
    }
    .modal-gallery-fg-fg-04 .lightbox-thumbnail-active img {
      border: 1px solid rgba(var(--color-accent-four-rgb),{{ section.settings.thumbnail_border_opacity_active | divided_by: 100.0 }});
    }
    .modal-gallery-fg-fg-05 .lightbox-thumbnail-active img {
      border: 1px solid rgba(var(--color-accent-five-rgb),{{ section.settings.thumbnail_border_opacity_active | divided_by: 100.0 }});
    }
    .product__info-container .product__title, .product__vendor_block, .product-button-block, .product__inset_image_block, .product-block-rating-wrapper, .product__upsell-products, .product-feature-icon-grid--wrapper, .product-inventory-container, .product-app-block, .product-text-clamp-toggle, .product-description-standard, .main-product--badge, .product-info-tabs, .product-breadcrumb-block, .product__info-container .product-price-block, .product__info-container .product__text, .product__info-container .product-custom-liquid-block {
      margin-bottom: {{ section.settings.blocks_vertical_spacing }}px;
    }
    .product__info-container > div:has(.installment) {
      margin-bottom: {{ section.settings.blocks_vertical_spacing | at_least: 20 }}px;
    }
    .product-share-component {
      margin-bottom: {{ section.settings.blocks_vertical_spacing | minus: 5 | at_least: 10 }}px;
    }
    .product__info-container .product-variant-picker-block, .product__info-container .product-form__quantity {
      margin-bottom: {{ section.settings.blocks_vertical_spacing | at_least: 20 }}px;
    }
    .product__cross-links {
      margin-top: {{ section.settings.blocks_vertical_spacing | at_least: 20 }}px;
      margin-bottom: {{ section.settings.blocks_vertical_spacing | at_least: 20 }}px;
    }
    .product-form__input:nth-child(1n) {
      margin-top: {{ section.settings.blocks_vertical_spacing | at_most: 20 }}px;
    }
    .product-buy-buttons-wrapper {
      margin-bottom: {{ section.settings.blocks_vertical_spacing | at_least: 30 }}px;
    }
    .product-block-hr-top {
      margin-bottom: {{ section.settings.blocks_vertical_spacing | at_least: 20 }}px;
    }
    .product-block-hr-bottom {
      margin-top: {{ section.settings.blocks_vertical_spacing | at_least: 20 }}px;
    }
    {% if section.settings.section_desktop_layout == 'stacked' %}
    .product-template-dt-stacked {
      background: {{ section.settings.media_bg_col }};
    }
    .product-main-info-section {
      background: var(--color-background);
    }
    {% endif %}
    {% if settings.badge_corner_radius > 18 %}
    .main-product--badge > span {
      padding: 5px 11px;
    }
    {% endif %}
    {% if section.settings.media_mobile_width == 'page-width' %}
    @media screen and (max-width: 750px) {
      .product-media-component {
        padding: var(--page-margin-mobile);
        padding-bottom: 0;
      }
      .product-media-component img, .product-media-component video {
        border-radius: var(--media-radius);
      }
    }
      @media screen and (min-width: 750px) and (max-width: 950px) {
      .product-media-component {
        padding: var(--page-margin-tablet);
      }
      .product-media-component img, .product-media-component video {
        border-radius: var(--media-radius);
      }
    }
    {% endif %}

    @media screen and (min-width: 750px) {
      .section-{{ section.id }}-padding {
        padding-bottom: {{ section.settings.padding_bottom }}px;
      }
      {% if section.settings.product_section_width == 'standard' %}
        .product-main-top-section {
          padding-left: var(--page-margin-tablet);
          padding-right: var(--page-margin-tablet);
        }
      {% endif %}
    }
          
    @media only screen and (min-width: 950px) {
      .section-{{ section.id }}-padding {
        padding-top: {{ section.settings.padding_top }}px;
        padding-bottom: {{ section.settings.padding_bottom }}px;
      }
      .pdp-border--vertical {
        height: calc(100% + {{ section.settings.padding_top }}px + {{ section.settings.padding_bottom }}px);
        top: -{{ section.settings.padding_top }}px;
      }
      .stacked-thumbnails-wrapper.stacked-gt-placement--adjacent {
        top: calc(var(--site-header-height-mobile) + {{ section.settings.padding_top | at_least: 20 }}px) !important;
      }
      body:has(.full-width-announcement-bar) .stacked-thumbnails-wrapper.stacked-gt-placement--adjacent {
        top: calc(var(--site-header-height-mobile) + 35px + {{ section.settings.padding_top | at_least: 20 }}px) !important;
      }
      .stacked-thumbnails-wrapper.stacked-thumbnails-wrapper.stacked-gt-placement--overlay {
        top: calc(var(--site-header-height-mobile) + 20px + {{ section.settings.padding_top }}px) !important;
      }
      body:has(.full-width-announcement-bar) .stacked-thumbnails-wrapper.stacked-gt-placement--overlay {
        top: calc(var(--site-header-height-mobile) + 45px + {{ section.settings.padding_top }}px) !important;
      }
      body:has(.full-width-announcement-bar) .product-template-dt-stacked .stacked-thumbnails-wrapper.stacked-gt-placement--overlay {
        top: 20px !important;
      }
      body:has(.header-bar--full) .product__column-sticky {
        top: calc(var(--site-header-height-desktop) + {{ section.settings.padding_top }}px);
      }
      body:has(.header-bar--full):has(.full-width-announcement-bar) .product__column-sticky {
        top: calc(var(--site-header-height-desktop) + 35px + {{ section.settings.padding_top }}px);
      }
      .product__info-container {
        max-width: {{ section.settings.text_section_max_width }}px;
      }
      .product__info-container {
        padding-top: {{ section.settings.text_section_padding | divided_by: 10 }}rem;
      }
      body:has(.hbi-semi-transparent) .product__info-container {
        padding-top: calc(var(--site-header-height-mobile) + {{ section.settings.text_section_padding }}px);
      }
      body:has(.header-bar--page-margins) .product__info-container {
        padding-top: calc(var(--site-header-height-mobile) + {{ section.settings.text_section_padding | plus: 10 }}px);
      }
      {% if section.settings.product_section_width == 'standard' %}
        .product-main-top-section {
          padding-left: var(--page-margin-tablet);
          padding-right: var(--page-margin-tablet);
        }
      {% endif %}
    }  
    
    @media only screen and (min-width: 1025px) {
      .stacked-thumbnails-wrapper.stacked-thumbnails-wrapper.stacked-gt-placement--adjacent {
        top: calc(var(--site-header-height-desktop) + {{ section.settings.padding_top | at_least: 20 }}px) !important;
      }
      body:has(.full-width-announcement-bar) .stacked-thumbnails-wrapper.stacked-gt-placement--adjacent {
        top: calc(var(--site-header-height-desktop) + 35px + {{ section.settings.padding_top | at_least: 20 }}px) !important;
      }
      .stacked-thumbnails-wrapper.stacked-thumbnails-wrapper.stacked-gt-placement--overlay {
        top: calc(var(--site-header-height-desktop) + 20px + {{ section.settings.padding_top }}px) !important;
      }
      body:has(.full-width-announcement-bar) .stacked-thumbnails-wrapper.stacked-gt-placement--overlay {
        top: calc(var(--site-header-height-desktop) + 55px + {{ section.settings.padding_top }}px) !important;
      }
      body:has(.hbi-semi-transparent) .product__info-container {
        padding-top: calc(var(--site-header-height-desktop) + {{ section.settings.text_section_padding }}px);
      }
      body:has(.header-bar--page-margins) .product__info-container {
        padding-top: calc(var(--site-header-height-desktop) + {{ section.settings.text_section_padding | plus: 10 }}px);
      }
      {% if section.settings.product_section_width == 'standard' %}
        .product-main-top-section {
          padding-left: var(--page-margin-desktop);
          padding-right: var(--page-margin-desktop);
        }
      {% endif %}
    }

    {% if settings.page_margin_desktop > 120 %}
    @media only screen and (min-width: 950px) and (max-width: 1300px) {
      .product-main-info-section {
        padding-left: 4rem !important;
      }
    }
    {% endif %}
    
    {%- if section.settings.bottom_border -%}
      .section-{{ section.id }}-padding {
        padding-bottom: 0;
      }
      .main-product--section .section-border {
        margin-top: {{ section.settings.padding_bottom_mobile }}px;
      }
      @media only screen and (min-width: 950px) {
        .section-{{ section.id }}-padding {
          padding-bottom: 0;
        }
        .main-product--section .section-border {
          margin-top: {{ section.settings.padding_bottom }}px;
        }
      }
    {%- endif -%}

    @media only screen and (max-width: 949px) {
      .sticky-buy-buttons .product-form {
        padding: {{ section.settings.sticky_buttons_padding }}px {{ section.settings.sticky_buttons_padding_horizontal }}px {{ section.settings.sticky_buttons_padding }}px {{ section.settings.sticky_buttons_padding_horizontal }}px;
        box-shadow: 0px 0px 12px 0px rgba(0,0,0,{{ section.settings.sticky_buttons_shadow | divided_by: 100.0 }});
      }
    }
    {%- if section.settings.padding_top > 0 -%}
    .pmc-thumbnail-position--adjacent-left-normal .gallery-slider-thumbnails, 
    .pmc-thumbnail-position--adjacent-left-large .gallery-slider-thumbnails,
    .pmc-thumbnail-position--adjacent-right-normal .gallery-slider-thumbnails, 
    .pmc-thumbnail-position--adjacent-right-large .gallery-slider-thumbnails {
      top: 0 !important;
    }
    {%- endif -%}
  {%- endstyle -%}


  <script src="{{ 'product-info.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>
  {% unless product.media.size == 0 %}
  <script src="{{ 'product-media-gallery.js' | asset_url }}" defer="defer"></script>
  {% endunless %}
  {%- if request.design_mode -%}
  <script src="{{ 'theme-editor.js' | asset_url }}" defer="defer"></script>
  {%- endif -%}

  {%- assign first_3d_model = product.media | where: 'media_type', 'model' | first -%}
  {%- if first_3d_model -%}  
  <script type="application/json" id="ProductJSON-{{ product.id }}">
      {{ product.media | where: 'media_type', 'model' | json }}
  </script>
  <script src="{{ 'product-model.js' | asset_url }}" defer></script>
  {{ 'component-product-model.css' | asset_url | stylesheet_tag }}
  <link
      id="ModelViewerStyle"
      rel="stylesheet"
      href="https://cdn.shopify.com/shopifycloud/model-viewer-ui/assets/v1.0/model-viewer-ui.css"
      media="print"
      onload="this.media='all'"
    >
    <link
      id="ModelViewerOverride"
      rel="stylesheet"
      href="{{ 'component-model-viewer-ui.css' | asset_url }}"
      media="print"
      onload="this.media='all'"
    >
  {%- endif -%}

<section id="ProductInfo-{{ section.id }}" class="main-product--section page-width-mob-full-width section-{{ section.id }}-padding">

{%- assign product_form_id = 'product-form-' | append: section.id -%}

  <div class="product-main-top-section{% if product.media.size == 0 %} product-main-media-zero{% endif %} product-template-dt-{{ section.settings.section_desktop_layout }} product-main-top-section-margin--{{ section.settings.product_section_width }} product-main-section-layout-{{ section.settings.media_section_width }}{% if section.settings.section_desktop_layout != 'stacked' %} media-offset--{{ section.settings.media_width_offset }}{% endif %}">
    <div class="product-main-media-section media-play-style--{{ section.settings.media_video_play_button_style }}{% if section.settings.product_section_width == 'standard' %} product-main-media-section-rounded-media{% endif %}" id="pageGallery-{{ section.id }}">
    {% unless product.media.size == 0 %}
      {% if section.settings.show_variant_image_only and product.selected_or_first_available_variant.featured_media %}
       {% render 'product-variant-media-gallery',
      layout: section.settings.gallery_layout,
      media_aspect_ratio: section.settings.gallery_aspect_ratio,
      media_scale: section.settings.gallery_media_scale,
      media_screen_height: section.settings.gallery_height_limit_desktop,
      enable_zoom: section.settings.zoom_enable,
      video_autoplay: section.settings.media_video_autoplay,
      grid_spacing: section.settings.gallery_grid_spacing,
      mobile_navigation: section.settings.mobile_media_nav,
      mobile_bullet_position: section.settings.mobile_media_nav_position,
      desktop_navigation: section.settings.desktop_media_nav,
      thumbnail_size_setting: section.settings.desktop_media_thumbnail_size,
      thumbnail_position_setting: section.settings.desktop_media_thumbnail_position,
      thumbnail_placement: section.settings.desktop_media_thumbnail_placement,
      balance_grid: section.settings.balance_grid
      %}       
    {% else %}
      {% render 'product-media-gallery',
      layout: section.settings.gallery_layout,
      media_aspect_ratio: section.settings.gallery_aspect_ratio,
      media_scale: section.settings.gallery_media_scale,
      media_screen_height: section.settings.gallery_height_limit_desktop,
      enable_zoom: section.settings.zoom_enable,
      video_autoplay: section.settings.media_video_autoplay,
      grid_spacing: section.settings.gallery_grid_spacing,
      mobile_navigation: section.settings.mobile_media_nav,
      mobile_bullet_position: section.settings.mobile_media_nav_position,
      desktop_navigation: section.settings.desktop_media_nav,
      thumbnail_size_setting: section.settings.desktop_media_thumbnail_size,
      thumbnail_position_setting: section.settings.desktop_media_thumbnail_position,
      thumbnail_placement: section.settings.desktop_media_thumbnail_placement,
      balance_grid: section.settings.balance_grid
      %}
      {% endif %}
      {% endunless %}
    </div>
    
    {% if section.settings.vertical_border and section.settings.section_desktop_layout != 'stacked' %}<div class="pdp-border--vertical"></div>{% endif %}

    <div class="product product-main-info-section align-{{ section.settings.info_txt_alignment }} vertical-align-{{ section.settings.text_section_vertical_position }}">
      <div class="product__info-container product-info-justify-{{ section.settings.text_section_position }}{% if section.settings.enable_sticky_info %} product__column-sticky{% endif %}{% if section.settings.enable_sticky_buttons_desktop %} sticky-buy-buttons-dt sticky-buttons-dt-width--full sticky-buy-buttons--border-{{ section.settings.sticky_buttons_border }} sticky-buttons-dt-position--{{ section.settings.sticky_buttons_desktop_position }} sticky-buttons-dt-margin--{{ section.settings.sticky_buttons_desktop_margin }}{% endif %}{% if section.settings.enable_sticky_buttons %} sticky-buy-buttons sticky-buy-buttons--border-{{ section.settings.sticky_buttons_border }}{% endif %}">
                
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when '@app' -%}
              <div class="product-app-block">
              {% render block %}
              </div>
            
            {%- when 'breadcrumb' -%}
            {% if product.metafields.custom.breadcrumb != blank %}
            {% assign position_counter = 0 %}
            <nav aria-label="Breadcrumb">
              <div class="product-breadcrumb-block text-small {{ block.settings.text_case }}" {{ block.shopify_attributes }}>
                <ol itemscope itemtype="https://schema.org/BreadcrumbList">
                {% if block.settings.homepage_link %}
                  {% assign position_counter = 1 %}
                  <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
                    <a itemprop="item" href="{{ routes.root_url }}"><span itemprop="name">{{ 'templates.home_page.home_page' | t }}</span></a> <span class="product-breadcrumb--divider">{% if block.settings.divider_style == 'slash' %}/{% else %}&bull;{% endif %}</span>
                    <meta itemprop="position" content="1" />
                  </li>
                {% endif %}
                {% for collection in product.metafields.custom.breadcrumb.value %}
                  {% assign position_counter = position_counter | plus: 1 %}
                  <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
                    <a itemprop="item" href="{{ collection.url }}"><span itemprop="name">{{ collection.title }}</span></a> <span class="product-breadcrumb--divider">{% if block.settings.divider_style == 'slash' %}/{% else %}&bull;{% endif %}</span>
                    <meta itemprop="position" content="{{ position_counter }}" />
                  </li>
                {% endfor %}
                  <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
                    <span class="product-breadcrumb--product-title" aria-current="page"><span itemprop="name">{{ product.title }}</span></span>
                    <meta itemprop="item" content="{{ canonical_url }}">
                    <meta itemprop="position" content="{{ position_counter | plus: 1 }}" />
                  </li>
                </ol>
              </div>
            </nav>
            {% endif %}
          {%- when 'text' -%}
            <style>
              .product-text-{{ block.id }} {
                padding: {{ block.settings.padding }}px;
                border-radius: {{ block.settings.border_radius }}px;
              }
            </style>
            <div class="product__text product-text-{{ block.id }} color-scheme-{{ block.settings.text_color }} color-scheme-{{ block.settings.bg_color }} rte" {{ block.shopify_attributes }}>
                {{ block.settings.text }}
            </div>

            {%- when 'button' -%}
            <div class="product-button-block" {{ block.shopify_attributes }}>
              <a class="button button--{{ block.settings.button_style }}" href="{{ block.settings.link }}">{{ block.settings.button_label }}</a>
            </div>

            {%- when 'table_row' -%}
            <style>
              .product__tr-{{ block.id }} .table-content {
                padding: {{ block.settings.padding }}px 0;
                margin-top: {{ block.settings.margin_top }}px;
                margin-bottom: {{ block.settings.margin_bottom }}px;
              }
            </style>
            <div class="product-table-row-block quick-add-hidden column-split-{{ block.settings.column_width }} product_tr-border-top-{{ block.settings.border_top }} product_tr-border-bottom-{{ block.settings.border_bottom }} product__tr-{{ block.id }}" {{ block.shopify_attributes }}>
              <div class="table-caption {{ block.settings.heading_style }}">{{ block.settings.caption }}</div>
              <div class="table-content">
              <div class="table-cell align-left">{{ block.settings.label }}</div>
              <div class="table-cell align-{{ block.settings.text_alignment }}">{{ block.settings.text }}</div>
              </div>
            </div>
            
            {%- when 'tags' -%}
            {% unless block.settings.badge_position == 'media' %}
            {% assign metafield_badges = product.metafields.custom.badges %}
            {% assign hascustombadges = false %}
            {% for tag in product.tags %}
            {% if tag contains 'Badge:' %}
              {% assign hascustombadges = true %}
            {% endif %}
            {% endfor %}
            
            {% if metafield_badges != blank %}
              {% assign hascustombadges = true %}
            {% endif %}

            {% if hascustombadges %}

            {% style %}
            .main-product--badge > span {
              font-size: {{ block.settings.badge_font_size }}px;
            }
            {% endstyle %}

            <div class="main-product--badge" {{ block.shopify_attributes }}>
            {% for tag in product.tags %}
            {% if tag contains 'Badge:' %}
              <span>{{ tag | remove: 'Badge: ' }}</span>
            {% endif %}
            {% endfor %}
            {% if metafield_badges != blank %}
            {% for badge in metafield_badges.value %}
              <span>{{ badge }}</span>
            {% endfor %}
            {% endif %}
            </div>
            {% endif %}
            {% endunless %}

            {%- when 'upsell_products' -%}
            {% if product.metafields.custom.upsell_products != blank %}
              
            {% assign card_padding = block.settings.card_padding %}
            {% assign card_padding_factor = block.settings.card_padding | times: 0.8 | round: 0 %}
            {% assign card_media_aspect_ratio = settings.card_img_aspect_ratio %}
            {% assign prod_limit = block.settings.product_limit %}
            {{ 'component-card.css' | asset_url | stylesheet_tag }}
            {% if block.settings.enable_quick_add %}
            {{ 'quick-add.css' | asset_url | stylesheet_tag }}
            <script src="{{ 'quick-add.js' | asset_url }}" defer="defer"></script>
            {% endif %}
            <style>
            .product-upsell-block-list .card-product {
              padding: {{ card_padding }}px;
              border-radius: {{ block.settings.card_radius }}px;
              border: 1px solid rgba(var(--color-foreground-rgb),{{ block.settings.card_border_opacity | divided_by: 100.0 }})
            }
            .product-upsell-block-list .card-product--image img {
              border-radius: {{ block.settings.card_radius | minus: card_padding_factor | at_least: 0 }}px;
            }
            </style>
            {% if card_padding == 0 and block.settings.card_radius < 2 %}
            <style>
            .product-upsell-block-list .card-product--image img {
              border-radius: {{ block.settings.card_radius | minus: card_padding_factor | at_least: 0 }}px 0 0 {{ block.settings.card_radius | minus: card_padding_factor | at_least: 0 }}px;
            }              
            </style>
            {% endif %}
            {% if card_padding == 0 and block.settings.card_radius > 2 and block.settings.card_border_opacity > 0 %}
            <style>
            .product-upsell-block-list .card-product--image img {
              border-radius: {{ block.settings.card_radius | minus: 1 }}px 0 0 {{ block.settings.card_radius | minus: 1 }}px;
            }              
            </style>
            {% endif %}
            {% if card_padding == 0 and block.settings.card_border_opacity > 0 %}
            <style>
            .product-upsell-block-list .product-card-quick-add {
              margin-right: 16px;
            }
            .product-upsell-block-list.add-position--below .card-product--text-section {
              padding-top: 12px !important;
            }
            </style>  
            {% endif %}
            
            <div class="product__upsell-products quick-add-hidden" {{ block.shopify_attributes }}>
              {% if block.settings.heading != blank %}
              <div class="product-upsell-block-list-heading">{{ block.settings.heading }}</div>
              {% endif %}
              <ul class="product-upsell-block-list card-media-size--{{ block.settings.card_media_size }} add-position--{{ block.settings.quick_add_button_position }}">
              {%- for product in product.metafields.custom.upsell_products.value limit: prod_limit -%}
                <li class="grid__item">
                  {% render 'card-product-basic',
                      card_product: product,
                      media_aspect_ratio: card_media_aspect_ratio,
                      show_secondary_image: false,
                      show_swiping_images: false,
                      pagination_color_scheme: 'body',
                      show_price: block.settings.show_price,
                      price_position: settings.card_price_position,
                      show_sale_badges: false,
                      show_vendor: block.settings.show_vendor,
                      show_vendor_inline: settings.card_show_vendor_inline,
                      lazy_load: true,
                      section_id: section.id,
                      show_quick_add: block.settings.enable_quick_add,
                      quick_add_button_style: block.settings.quick_add_button_style,
                      placeholder: false
                    %}
                </li>
              {%- endfor -%}
              </ul>
            </div>
            {% endif %}
            
            {%- when 'cross_links' -%}
            {% if product.metafields.custom.cross_links != blank %}
            <div class="product__cross-links" {{ block.shopify_attributes }}>
            <div class="product-cross-link-heading">{{ block.settings.heading }}

              {% assign current_product = product | sort %}
              {% assign current_product_url = product.url %}
              {% assign cross_list = product.metafields.custom.cross_links.value | concat: current_product | sort_natural: 'url' %}
              {% assign cross_list_sorted = cross_list %}

              {% assign metafield = product.metafields.custom.color.value %}
            
              {% for metaobject in metafield %}              
                {% capture swatch_label_name %}
                {% for metaobject in metafield %}{% if metaobject.name %}{{ metaobject.name }}{% unless forloop.last %}/{% endunless %}{% endif %}{% endfor %}
                {% endcapture %}
              {% endfor %}            
            
              <div class="caption">{% if block.settings.label != blank %}{{ block.settings.label }} {% endif %}{% if block.settings.show_color_label %}{{ swatch_label_name }}{% endif %}</div>

            </div>
            
              {% if block.settings.link_type == 'thumbnail' %}         
              <div class="product-cross-links-list pcl-ratio-{{ section.settings.gallery_aspect_ratio }}">
                
                {% assign current_product = product | sort %}
                {% assign current_product_url = product.url %}
                {% assign cross_list = product.metafields.custom.cross_links.value | concat: current_product | sort_natural: 'url' %}
                {% assign cross_list_sorted = cross_list %}
                
                {% for product in cross_list_sorted %}           
                <div class="product-cross-link-item">
                <a href="{{ product.url }}">
                <div class="product-cross-link-thumbnail{% if product.url == current_product_url %} cl-item-selected{% endif %}{% unless product.available %} product-cross-link-thumbnail--unavailable{% endunless %}">
                  {% assign cl_image = product.metafields.custom.cross_link_thumbnail %}
                  {% if cl_image and cl_image.value != blank %}
                    <img src="{{ cl_image.value | image_url }}" width="140" height="auto" />
                  {% endif %}
                  {% if product.featured_media and cl_image.value == blank %}
                    {{ product.featured_media | image_url: width: 140 | image_tag: loading: 'lazy' }}
                  {% endif %}
                </div>
                </a>
                </div>       
                {% endfor %}
              </div>
              {% endif %}
              
              {% if block.settings.link_type == 'swatch_square' or block.settings.link_type == 'swatch_round' or block.settings.link_type == 'swatch_rectangle' %}
                {% assign swatch_image_size = 48 %}
                {% if block.settings.swatch_size == 'medium' %}
                  {% assign swatch_image_size = 64 %}
                {% endif %}
                {% if block.settings.swatch_size == 'large' %}
                  {% assign swatch_image_size = 72 %}
                {% endif %}
              <ul role="list" class="cross-link-swatch-list swatch-list-style-{{ block.settings.link_type }} swatch-size--{{ block.settings.swatch_size }}">
              {% for product in cross_list_sorted %}
                {% assign swatch_color = '' %}
                {% assign swatch_secondary_color = '' %}

                {% assign metafield = product.metafields.custom.color.value %}
                
                {% for metaobject in metafield %}
                  {% assign swatch_image = metaobject.swatch_image.value %}
                  {% if forloop.first %}
                    {% assign swatch_color = metaobject.swatch.value %}
                  {% endif %}
                  {% if forloop.index == 2 %}
                    {% assign swatch_secondary_color = metaobject.swatch.value %}
                  {% endif %}
                {% endfor %}
              
              {% capture swatch_accessibility_name %}
              {% for metaobject in metafield %}{% if metaobject.name %}{{ metaobject.name }}{% unless forloop.last %}/{% endunless %}{% endif %}{% endfor %}
              {% endcapture %}
                
              <li class="swatch-list-item text-small{% unless product.available %} swatch-list-item--unavailable{% endunless %}">
                <a{% if product.url == current_product_url %} class="selected"{% endif %} href="{{ product.url }}" 
                  title="{{ swatch_accessibility_name | strip }}">
                {% assign swatch_brightness = swatch_color | color_brightness %}
                <div class="swatch-dot{% if swatch_brightness > 125 %} swatch-dot--light{% else %} swatch-dot--dark{% endif %}" style="background: {{ swatch_color }}">
                  {% if swatch_image contains 'png' or swatch_image contains 'jpg' %}
                    {{ swatch_image | image_url: width: swatch_image_size | image_tag: loading: 'lazy' }}
                  {% endif %}
                  {% if swatch_secondary_color != empty %}<div class="secondary-swatch-color" style="background: {{ swatch_secondary_color }}"></div>{% endif %}
                </div>
                </a>
              </li>
              {% endfor %}
              </ul> 
                
              {% endif %}
              
            </div>
            {% endif %}
            
            {%- when 'title' -%}
            <div class="product__title" {{ block.shopify_attributes }}>
              <h1 class="{{ block.settings.title_size }}">{{ product.title }}</h1>
                <a href="{{ product.url }}" class="product__title pt__quick_view">
                  <h2 class="{{ block.settings.title_size }}">
                    {{ product.title | escape }}
                  </h2>
                </a>
            </div>


            {%- when 'icon_grid' -%}
            {% assign icon_render_size = block.settings.icon_size_desktop | times: 2 %}
            <style>
            .product-feature-icon-grid {
              display: flex;
              column-gap: {{ block.settings.grid_spacing_mobile }}px;
              row-gap: {{ block.settings.grid_spacing_mobile }}px;
            }
            .product-feature-icon--text {
              max-width: {{ block.settings.icon_text_max_width }}px; 
            }
            .product-feature-icon--image img {
              width: {{ block.settings.icon_size_mobile }}px;
              height: auto;  
            }
            {% unless block.settings.grid_columns_mobile == 'auto' %}
            .product-feature-icon-grid {
              display: grid;
              grid-template-columns: repeat({{ block.settings.grid_columns_mobile }}, 1fr);
              grid-template-rows: repeat(1, 1fr);
            }
            {% endunless %}              
            @media only screen and (min-width: 950px) {
              .product-feature-icon--image img {
                width: {{ block.settings.icon_size_desktop }}px;
                height: auto;  
              }
            }
            {% unless block.settings.grid_columns_mobile == 'auto' %}
            @media only screen and (min-width: 950px) {
              .product-feature-icon-grid {
                display: grid;
                column-gap: {{ block.settings.grid_spacing_desktop }}px;
                row-gap: {{ block.settings.grid_spacing_desktop }}px;
                grid-template-columns: repeat({{ block.settings.grid_columns_desktop }}, 1fr);
                grid-template-rows: repeat(1, 1fr);
              }
            }
            {% endunless %}
            {% if block.settings.grid_columns_desktop == 'auto' %}
            .product-feature-icon-grid {
              display: flex;
              align-items: center;
              justify-content: center;
              flex-wrap: wrap;
              column-gap: {{ block.settings.grid_spacing_desktop }}px;
              row-gap: {{ block.settings.grid_spacing_desktop }}px;
            }
            .product-feature-icon--item {
              width: auto;
            }
            {% endif %}
            </style>
            
            <div class="product-feature-icon-grid--wrapper align-{{ block.settings.icon_alignment }}" {{ block.shopify_attributes }}>
              <ul class="product-feature-icon-grid icon-layout--{{ block.settings.icon_layout }} grid-columns-mobile--{{ block.settings.grid_columns_mobile }} grid-columns-desktop--{{ block.settings.grid_columns_desktop }}">
              {% if block.settings.icon_one_image %}
              <li class="product-feature-icon--item caption">
              <div class="product-feature-icon--image">
              {{ block.settings.icon_one_image | image_url: width: icon_render_size | image_tag: loading: 'lazy' }}
              </div>
              <div class="product-feature-icon--text">{{ block.settings.icon_one_label }}</div>
              </li>
              {% endif %}

              {% if block.settings.icon_two_image %}
              <li class="product-feature-icon--item caption">
              <div class="product-feature-icon--image">
              {{ block.settings.icon_two_image | image_url: width: icon_render_size | image_tag: loading: 'lazy' }}
              </div>
              <div class="product-feature-icon--text">{{ block.settings.icon_two_label }}</div>
              </li>
              {% endif %}

              {% if block.settings.icon_three_image %}
              <li class="product-feature-icon--item caption">
              <div class="product-feature-icon--image">
              {{ block.settings.icon_three_image | image_url: width: icon_render_size | image_tag: loading: 'lazy' }}
              </div>
              <div class="product-feature-icon--text">{{ block.settings.icon_three_label }}</div>
              </li>
              {% endif %}
                
              {% if block.settings.icon_four_image %}
              <li class="product-feature-icon--item caption">
              <div class="product-feature-icon--image">
              {{ block.settings.icon_four_image | image_url: width: icon_render_size | image_tag: loading: 'lazy' }}
              </div>
              <div class="product-feature-icon--text">{{ block.settings.icon_four_label }}</div>
              </li>
              {% endif %}

              {% if block.settings.icon_five_image %}
              <li class="product-feature-icon--item caption">
              <div class="product-feature-icon--image">
              {{ block.settings.icon_five_image | image_url: width: icon_render_size | image_tag: loading: 'lazy' }}
              </div>
              <div class="product-feature-icon--text">{{ block.settings.icon_five_label }}</div>
              </li>
              {% endif %}

              {% if block.settings.icon_six_image %}
              <li class="product-feature-icon--item caption">
              <div class="product-feature-icon--image">
              {{ block.settings.icon_six_image | image_url: width: icon_render_size | image_tag: loading: 'lazy' }}
              </div>
              <div class="product-feature-icon--text">{{ block.settings.icon_six_label }}</div>
              </li>
              {% endif %}                
              </ul>
            </div>
            
            {% when 'vendor' %}
            <div class="product__vendor_block" {{ block.shopify_attributes }}>
              {% if block.settings.link_to_collection %}
              <a href="{{ routes.collections_url }}/{{ product.vendor | handleize }}">{{ product.vendor }}</a>
              {% else %}
              {{ product.vendor }}
              {% endif %}
            </div>

            {% when 'inset_image' %}
            {% if block.settings.image %}
            {% assign media_render_size = 200 %}
            {% if block.settings.image_size == 'micro' %}
            {% assign media_render_size = 140 %}  
            {% endif %}
            {% if block.settings.image_size == 'medium' %}
            {% assign media_render_size = 280 %}  
            {% endif %}
            {% if block.settings.image_size == 'large' %}
            {% assign media_render_size = 400 %}  
            {% endif %}
            {% if block.settings.image_size == 'xl' %}
            {% assign media_render_size = 600 %}  
            {% endif %}
            <style>
              .{{ block.id }} {
                padding-top: {{ block.settings.padding_top }}px;
                padding-bottom: {{ block.settings.padding_bottom }}px
              }
              .align-center .product__inset_image_block.{{ block.id }} {
                margin: 0 auto;
                margin-bottom: {{ section.settings.blocks_vertical_spacing }}px;
              }
            </style>
            <div class="product__inset_image_block {{ block.id }} media-size--{{ block.settings.image_size }} media-ratio--{{ block.settings.media_ratio }}" {{ block.shopify_attributes }}>
              <div class="product__inset_image_block__image">
                {{ block.settings.image | image_url: width: media_render_size | image_tag: loading: 'lazy' }}
              </div>
            </div>
            {% endif %}

          {% when 'inset_video' %}
            {% if block.settings.video %}
            <style>
              .{{ block.id }} {
                padding-top: {{ block.settings.padding_top }}px;
                padding-bottom: {{ block.settings.padding_bottom }}px
              }
              .align-center .product__inset_image_block.{{ block.id }} {
                margin: 0 auto;
                margin-bottom: {{ section.settings.blocks_vertical_spacing }}px;
              }
            </style>
            <div class="product__inset_image_block {{ block.id }} media-size--{{ block.settings.image_size }} media-ratio--{{ block.settings.media_ratio }}" {{ block.shopify_attributes }}>
              <div class="product__inset_image_block__image">
              {% assign video_id = 'pdp-inset-vid-' | append: block.id %}
                {{
                  block.settings.video
                  | video_tag:
                    id: video_id,
                    image_size: '800x',
                    autoplay: true,
                    loop: true,
                    controls: false,
                    muted: true
                }}
              </div>
            </div>
            {% endif %}
            
            {%- when 'price' -%}
            {% assign pricesizeclass = block.settings.price_size %}
              <div class="product-price-block{% if block.settings.price_show_taxes %} tax-position--{{ block.settings.price_taxes_position }}{% endif %} no-js-hidden" id="price-{{ section.id }}" role="status" {{ block.shopify_attributes }}>
                {%- render 'price',
                  product: product,
                  use_variant: true,
                  show_discounts: block.settings.show_discounts,
                  price_class: pricesizeclass
                -%}
                {% if block.settings.price_show_taxes %}
                  {%- if shop.taxes_included or shop.shipping_policy.body != blank -%}
                    <div class="product__tax caption">
                      {%- if shop.taxes_included -%}
                        {{ 'products.product.include_taxes' | t }}
                      {%- endif -%}
                      {%- if shop.shipping_policy.body != blank -%}
                        {{ 'products.product.shipping_policy_html' | t: link: shop.shipping_policy.url }}
                      {%- endif -%}
                    </div>
                  {%- endif -%}
                {% endif %}
              </div>
            {% if block.settings.show_shoppay_banner %}
              <div {{ block.shopify_attributes }}>
                {%- assign product_form_installment_id = 'product-form-installment-' | append: section.id -%}
                {%- form 'product', product, id: product_form_installment_id, class: 'installment caption-large' -%}
                  <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
                  {{ form | payment_terms }}
                {%- endform -%}
              </div>
              {% endif %}
              
              {%- when 'inventory' -%}

              <div class="product-inventory-container{% if block.settings.inventory-color-coded %} inventory-color-coded{% endif %} inventory-display-type-{{ block.settings.inventory_display }}" {{ block.shopify_attributes }}>            
              <p class="product__inventory text-small no-js-hidden{% if product.selected_or_first_available_variant.inventory_management != 'shopify' %} visibility-hidden{% endif %}"
                              {{ block.shopify_attributes }}
                              id="Inventory-{{ section.id }}"
                              role="status"
                            >
              {%- if product.selected_or_first_available_variant.inventory_management == 'shopify' -%}
              
              {% if block.settings.inventory_display == 'quantity' %}
              <span class="inventory-display--quantity{% if product.selected_or_first_available_variant.inventory_quantity == 0 %} inventory-display--quantity-zero{% endif %}{% if product.selected_or_first_available_variant.inventory_quantity > 0 and product.selected_or_first_available_variant.inventory_quantity <= block.settings.inventory_threshold %} inventory-display--quantity-low{% endif %}"><span class="inventory-number">{{ product.selected_or_first_available_variant.inventory_quantity }}</span>&nbsp;{{- 'products.product.inventory_in_stock' | t -}}</span>
              {% endif %}

              {% if block.settings.inventory_display == 'status' %}

              {%- if product.selected_or_first_available_variant.inventory_quantity == 0 and product.selected_or_first_available_variant.inventory_policy == 'deny' -%}
              <span class="inventory-display--message inventory-display--quantity-zero">{{- 'products.product.inventory_out_of_stock' | t -}}</span>
              {%- endif -%}

              {%- if product.selected_or_first_available_variant.inventory_quantity == 0 and product.selected_or_first_available_variant.inventory_policy == 'continue' -%}
              <span class="inventory-display--message inventory-display--quantity-normal{% if block.settings.hide_if_in_stock %} inventory--hide-in-stock{% endif %}">{{- 'products.product.inventory_out_of_stock_continue_selling' | t -}}</span>
              {%- endif -%}
              
              {%- if product.selected_or_first_available_variant.inventory_quantity > 0 and product.selected_or_first_available_variant.inventory_quantity <= block.settings.inventory_threshold and block.settings.inventory_threshold > 0 -%}
              <span class="inventory-display--message inventory-display--quantity-low">{{- 'products.product.inventory_low_stock' | t -}}</span>
              {%- endif -%}     

              {%- if product.selected_or_first_available_variant.inventory_quantity > 0 and product.selected_or_first_available_variant.inventory_quantity > block.settings.inventory_threshold -%}
              <span class="inventory-display--message inventory-display--quantity-normal{% if block.settings.hide_if_in_stock %} inventory--hide-in-stock{% endif %}">{{- 'products.product.inventory_in_stock' | t -}}</span>
              {%- endif -%}

              {% endif %}

              {%- endif -%}
              </p>
              </div>

              {%- when 'rating' -%}
                {%- if product.metafields.reviews.rating.value != blank -%}
                  <div class="product-block-rating-wrapper">
                    {% liquid
                      assign rating_decimal = 0
                      assign decimal = product.metafields.reviews.rating.value.rating | modulo: 1
                      if decimal >= 0.3 and decimal <= 0.7
                        assign rating_decimal = 0.5
                      elsif decimal > 0.7
                        assign rating_decimal = 1
                      endif
                    %}
                    <div
                      class="rating"
                      role="img"
                      aria-label="{{ 'accessibility.star_reviews_info' | t: rating_value: product.metafields.reviews.rating.value, rating_max: product.metafields.reviews.rating.value.scale_max }}"
                    >
                      <span
                        aria-hidden="true"
                        class="rating-star"
                        style="--rating: {{ product.metafields.reviews.rating.value.rating | floor }}; --rating-max: {{ product.metafields.reviews.rating.value.scale_max }}; --rating-decimal: {{ rating_decimal }};"
                      ></span>
                    </div>
                    <p class="rating-text caption">
                      <span aria-hidden="true">
                        {{- product.metafields.reviews.rating.value }} /
                        {{ product.metafields.reviews.rating.value.scale_max -}}
                      </span>
                    </p>
                    <p class="rating-count caption">
                      <span aria-hidden="true">{{ product.metafields.reviews.rating_count }} {{ 'products.product.reviews' | t }}</span>
                      <span class="visually-hidden">
                        {{- product.metafields.reviews.rating_count }}
                        {{ 'accessibility.total_reviews' | t -}}
                      </span>
                    </p>
                  </div>
                {%- endif -%}
            
            {%- when 'description' -%}
            {% assign specifications_split_word = 'SPECIFICATIONS' %}

            {% if section.settings.description_split_keyword != blank %}
            {% assign specifications_split_word = section.settings.description_split_keyword %}
            {% endif %}
            {%- if product.description != blank -%}

              {% if block.settings.display_type == 'accordion' %}

              {% assign expanded_initial_state = false %}
                
              {% if block.settings.accordion_open_default %}
              {% assign expanded_initial_state = true %} 
              {% endif %}
              
              <div class="accordion" {{ block.shopify_attributes }}>
              <button class="accordion-title{% if expanded_initial_state == true %} active{% endif %}" aria-expanded="{{ expanded_initial_state }}" aria-controls="{{ section.id }}-{{ block.id }}-description" id="{{ section.id }}-{{ block.id }}-button">{{ 'products.product.description' | t }}
              <div class="accordion-icons-wrapper">
              <div class="accordion-icon-open">{% if settings.accordion_icon == 'plus' %}{% render 'icon-plus' %}{% else %}{% render 'icon-caret' %}{% endif %}</div>
              <div class="accordion-icon-close">{% if settings.accordion_icon == 'plus' %}{% render 'icon-minus' %}{% else %}{% render 'icon-caret' %}{% endif %}</div>
              </div>
              </button>
              <div id="{{ section.id }}-{{ block.id }}-description" class="accordion-panel{% if expanded_initial_state == true %} panel-open{% endif %}" {% if expanded_initial_state == true %}aria-hidden="false"{% else %}aria-hidden="true"{% endif %} aria-labelledby="{{ section.id }}-{{ block.id }}-button">
              {{ product.description | split: specifications_split_word | first }}
              </div>
              </div>
              {% endif %}
              
              {% if block.settings.display_type == 'truncated' %} 
              <div id="productDescriptionTxt" class="product-description-static{% if product.description.size < 50 %} product-description-standard{% endif %}{% if block.settings.text_indent %} description-indent{% endif %}{% if product.description.size > 50 %} text-line-clamp-three{% endif %} rte" {{ block.shopify_attributes }}>
                {{ product.description | split: specifications_split_word | first }}
              </div>
              {% unless product.description.size < 50 %}
              <button id="TxtClampControl" class="product-text-clamp-toggle" tabindex="0" aria-controls="productDescriptionTxt" aria-label="{{ 'products.product.read_more' | t }}">
                <span class="closed">{{ 'products.product.read_more' | t }}</span>
                <span class="open">{{ 'products.product.read_less' | t }}</span>
              </button>
              <script>
                const clamp_toggle = document.getElementById('TxtClampControl');
                const text = document.getElementById('productDescriptionTxt');
                if(clamp_toggle) { 
                clamp_toggle.addEventListener('click', function() {
                  text.classList.toggle('text-line-clamp-three');
                  this.classList.toggle('open');
                });
                }
              </script>
              {% endunless %}
              {% endif %}
              {%- endif -%}
              {% if block.settings.display_type == 'normal' %}
              <div id="productDescriptionTxt" class="product-description-standard product-description-static{% if block.settings.text_indent %} description-indent{% endif %} rte" {{ block.shopify_attributes }}>
                {{ product.description | split: specifications_split_word | first }}
              </div>
              {% endif %}

            {% if block.settings.display_type == 'drawer' %}
            <div class="product-description-standard quick-add-hidden" {{ block.shopify_attributes }}>
            <button class="product-description-drawer--opener link-style--{{ block.settings.description_drawer_link_style }}">
              {{ 'products.product.description' | t }}
              {% if block.settings.description_drawer_link_style == 'arrow' %}{% render 'icon-caret' %}{% endif %}
            </button>
            </div>
            {% endif %}

            {%- when 'product_specifications' -%}
              {% if product.description contains specifications_split_word %}
              <div class="accordion" {{ block.shopify_attributes }}>
              <button class="accordion-title" aria-expanded="false" id="{{ section.id }}-{{ block.id }}-details-button" aria-controls="{{ section.id }}-{{ block.id }}-details-panel">{{ block.settings.title }}
              <div class="accordion-icons-wrapper">
              <div class="accordion-icon-open">{% if settings.accordion_icon == 'plus' %}{% render 'icon-plus' %}{% else %}{% render 'icon-caret' %}{% endif %}</div>
              <div class="accordion-icon-close">{% if settings.accordion_icon == 'plus' %}{% render 'icon-minus' %}{% else %}{% render 'icon-caret' %}{% endif %}</div>  
              </div>
              </button>
              <div class="accordion-panel" id="{{ section.id }}-{{ block.id }}-details-panel" aria-hidden="true" aria-labelledby="{{ section.id }}-{{ block.id }}-details-button">
              {{ product.description | split: specifications_split_word | last }}
              </div>
              </div>
              {% endif %}

            {%- when 'sku' -%}
            {% if product.selected_or_first_available_variant.sku.size > 1 %}
              <p
                class="product__sku text-small no-js-hidden{% if product.selected_or_first_available_variant.sku.size == 0 %} visibility-hidden{% endif %}"
                id="Sku-{{ section.id }}"
                role="status"
                {{ block.shopify_attributes }}
              >
                <span class="visually-hidden">{{ 'products.product.sku' | t }}:</span> {{- product.selected_or_first_available_variant.sku -}}
              </p>
              {% endif %}
            
            {%- when 'custom_liquid' -%}
            <div class="product-custom-liquid-block" {{ block.shopify_attributes }}>
              {{ block.settings.custom_liquid }}
            </div>

            {%- when 'tabs' -%}
            <script src="{{ 'component-tabs.js' | asset_url }}" defer="defer"></script>

            <style>
              .product-info-tabs .tab-content {
                text-align: {{ block.settings.text_alignment }}
              }
            </style>
            
            {% assign specifications_split_word = 'SPECIFICATIONS' %}

            {% if section.settings.description_split_keyword != blank %}
            {% assign specifications_split_word = section.settings.description_split_keyword %}
            {% endif %}
            
            <div class="product-info-tabs tab-grand" {{ block.shopify_attributes }}>

            <div role="tablist" class="tab-menu tab-style-{{ block.settings.tab_style }} tab-spacing-{{ block.settings.tab_spacing }}{% if block.settings.tab_list_border %} tab-menu-with-border{% endif %} tab-font-{{ block.settings.tab_font_family }}">
            {% if block.settings.description_tab and product.description != blank %}
            <button role="tab" id="productTabZero" class="tab-button" aria-controls="productTabContentZero" aria-selected="true">{{ block.settings.description_label }}</button>
            {% endif %}
            <button role="tab" id="productTabOne" class="tab-button" aria-controls="productTabContentOne" {% if block.settings.description_tab and product.description != blank %}aria-selected="false"{% else %}aria-selected="true"{% endif %}>{{ block.settings.tab_one_label }}</button>
            {% if block.settings.tab_two_label != blank %}<button role="tab" id="productTabTwo" class="tab-button" aria-controls="productTabContentTwo" aria-selected="false">{{ block.settings.tab_two_label }}</button>{% endif %}
            {% if block.settings.tab_three_label != blank %}<button role="tab" id="productTabThree" class="tab-button" aria-controls="productTabContentThree" aria-selected="false">{{ block.settings.tab_three_label }}</button>{% endif %}
            </div>

            {% if block.settings.description_tab and product.description != blank %}
            <div id="productTabContentZero" class="tab-content rte" role="tabpanel" aria-labelled-by="productTabZero">
              {{ product.description | split: specifications_split_word | first }}
            </div>
            {% endif %}
            {% if block.settings.tab_one_label != blank %}
            <div id="productTabContentOne" class="tab-content rte" role="tabpanel" aria-labelled-by="productTabOne"{% if block.settings.description_tab and product.description != blank %}hidden{% endif %}>
              {{ block.settings.tab_one_text }}
            </div>
            {% endif %}
            {% if block.settings.tab_two_label != blank %}
            <div id="productTabContentTwo" class="tab-content rte" role="tabpanel" aria-labelled-by="productTabTwo" hidden>
              {{ block.settings.tab_two_text }}
            </div>
            {% endif %}
            {% if block.settings.tab_three_label != blank %}
            <div id="productTabContentThree" class="tab-content rte" role="tabpanel" aria-labelled-by="productTabThree" hidden>
              {{ block.settings.tab_three_text }}
            </div>
            {% endif %}
              
            </div>
            
            {%- when 'collapsible_tab' -%}  
              <div class="accordion" {{ block.shopify_attributes }}>
              <button class="accordion-title" aria-expanded="false" aria-controls="{{ block.id }}-{{ section.id }}-details-panel" id="{{ block.id }}-{{ section.id }}-details-button">{{ block.settings.heading | default: block.settings.page.title }}
              <div class="accordion-icons-wrapper">
              <div class="accordion-icon-open">{% if settings.accordion_icon == 'plus' %}{% render 'icon-plus' %}{% else %}{% render 'icon-caret' %}{% endif %}</div>
              <div class="accordion-icon-close">{% if settings.accordion_icon == 'plus' %}{% render 'icon-minus' %}{% else %}{% render 'icon-caret' %}{% endif %}</div>
              </div>
              </button>
              <div class="accordion-panel{% if block.settings.content == blank and block.settings.page.content == blank %} accordion-panel--no-content{% endif %}" id="{{ block.id }}-{{ section.id }}-details-panel" aria-hidden="true" aria-labelledby="{{ block.id }}-{{ section.id }}-details-button">
              {{ block.settings.content }}
              {{ block.settings.page.content }}
              </div>
              </div>
            

              {%- when 'quantity_selector' -%}
              <div
                id="Quantity-Form-{{ section.id }}"
                class="product-form__input product-form__quantity"
                {{ block.shopify_attributes }}
              >
              {% if block.settings.border_top %}
              <hr class="product-block-hr-top" />
              {% endif %}
                <div class="quantity-selector-layout-{{ block.settings.selector_layout }}">                  
                    {% # theme-check-disable %}
                    {%- assign cart_qty = cart | item_count_for_variant: product.selected_or_first_available_variant.id -%}
                    {% # theme-check-enable %}
                    <span class="visually-hidden" id="quantity-label-{{ section.id }}">
                      {%- if cart_qty > 0 -%}
                        {{- 'products.product.quantity.in_cart_html' | t: quantity: cart_qty -}}
                      {%- else -%}
                        {{- 'products.product.quantity.label' | t -}}
                      {%- endif -%}
                    </span>
                    <label
                      class="quantity__label form__label{% unless block.settings.show_label %} visually-hidden{% endunless %}"
                      for="Quantity-{{ section.id }}"
                      aria-labelledby="quantity-label-{{ section.id }}"
                    >
                      <span>{{ 'products.product.quantity.label' | t }}</span>
                      <span class="quantity__rules-cart{% if cart_qty == 0 %} hidden{% endif %}" aria-hidden="true">
                        <span>({{- 'products.product.quantity.in_cart_html' | t: quantity: cart_qty -}})</span>
                        {%- render 'loading-spinner' -%}
                      </span>
                    </label>
                    <div class="price-per-item__container">
                      <quantity-input class="quantity qty-selector-border-style--{{ settings.qty_selector_border }}" data-url="{{ product.url }}" data-section="{{ section.id }}">
                        <button class="quantity__button" name="minus" type="button">
                          <span class="visually-hidden">
                            {{- 'products.product.quantity.decrease' | t: product: product.title | escape -}}
                          </span>
                          {% render 'icon-minus' %}
                        </button>
                          <input
                            class="quantity__input"
                            type="number"
                            name="quantity"
                            id="Quantity-{{ section.id }}"
                            data-cart-quantity="{{ cart_qty }}"
                            data-min="{{ product.selected_or_first_available_variant.quantity_rule.min }}"
                            min="{{ product.selected_or_first_available_variant.quantity_rule.min }}"
                            {% if product.selected_or_first_available_variant.quantity_rule.max != null %}
                              data-max="{{ product.selected_or_first_available_variant.quantity_rule.max }}"
                              max="{{ product.selected_or_first_available_variant.quantity_rule.max }}"
                            {% endif %}
                            {% if product.selected_or_first_available_variant.quantity_rule.max == null and product.selected_or_first_available_variant.inventory_management == 'shopify' and product.selected_or_first_available_variant.inventory_policy == 'deny' %}
                              data-max="{{ product.selected_or_first_available_variant.inventory_quantity | at_least: 1 }}"
                              max="{{ product.selected_or_first_available_variant.inventory_quantity | at_least: 1 }}"
                            {% endif %}
                            {% if product.selected_or_first_available_variant.quantity_rule.max == null and product.selected_or_first_available_variant.inventory_management == 'shopify' and product.selected_or_first_available_variant.inventory_policy == 'continue' %}
                              data-max="999"
                              max="999"
                            {% endif %}
                            step="{{ product.selected_or_first_available_variant.quantity_rule.increment }}"
                            value="{{ product.selected_or_first_available_variant.quantity_rule.min }}"
                            form="{{ product_form_id }}"
                          />
                        <button class="quantity__button" name="plus" type="button">
                          <span class="visually-hidden">
                            {{- 'products.product.quantity.increase' | t: product: product.title | escape -}}
                          </span>
                          {% render 'icon-plus' %}
                        </button>
                      </quantity-input>
                      {%- liquid
                        assign volume_pricing_array = product.selected_or_first_available_variant.quantity_price_breaks | sort: 'quantity' | reverse
                        assign current_qty_for_volume_pricing = cart_qty | plus: product.selected_or_first_available_variant.quantity_rule.min
                        if cart_qty > 0
                          assign current_qty_for_volume_pricing = cart_qty | plus: product.selected_or_first_available_variant.quantity_rule.increment
                        endif
                      -%}
                      {%- if product.quantity_price_breaks_configured? -%}
                        <price-per-item
                          id="Price-Per-Item-{{ section.id }}"
                          data-section-id="{{ section.id }}"
                          data-variant-id="{{ product.selected_or_first_available_variant.id }}"
                        >
                          {%- if product.selected_or_first_available_variant.quantity_price_breaks.size > 0 -%}
                            {%- assign variant_price_compare = product.selected_or_first_available_variant.compare_at_price -%}
                            <div class="price-per-item">
                              {%- if variant_price_compare -%}
                                <dl class="price-per-item--current">
                                  <dt class="visually-hidden">
                                    {{ 'products.product.price.regular_price' | t }}
                                  </dt>
                                  <dd>
                                    <s class="variant-item__old-price">
                                      {{ variant_price_compare | money_with_currency }}
                                    </s>
                                  </dd>
                                </dl>
                              {%- endif -%}
                              {%- if current_qty_for_volume_pricing < volume_pricing_array.last.minimum_quantity -%}
                                {%- assign variant_price = product.selected_or_first_available_variant.price
                                  | money_with_currency
                                -%}
                                <span class="price-per-item--current">
                                  {{- 'products.product.volume_pricing.price_at_each' | t: price: variant_price -}}
                                </span>
                              {%- else -%}
                                {%- for price_break in volume_pricing_array -%}
                                  {%- if current_qty_for_volume_pricing >= price_break.minimum_quantity -%}
                                    {%- assign price_break_price = price_break.price | money_with_currency -%}
                                    <span class="price-per-item--current">
                                      {{- 'products.product.volume_pricing.price_at_each' | t: price: price_break_price -}}
                                    </span>
                                    {%- break -%}
                                  {%- endif -%}
                                {%- endfor -%}
                              {%- endif -%}
                            </div>
                          {%- else -%}
                            {%- assign variant_price = product.selected_or_first_available_variant.price
                              | money_with_currency
                            -%}
                            {%- assign variant_price_compare = product.selected_or_first_available_variant.compare_at_price -%}
                            <div class="price-per-item">
                              {%- if variant_price_compare -%}
                                <dl class="price-per-item--current">
                                  <dt class="visually-hidden">
                                    {{ 'products.product.price.regular_price' | t }}
                                  </dt>
                                  <dd>
                                    <s class="variant-item__old-price">
                                      {{ variant_price_compare | money_with_currency }}
                                    </s>
                                  </dd>
                                  <dt class="visually-hidden">
                                    {{ 'products.product.price.sale_price' | t }}
                                  </dt>
                                  <dd>
                                    <span class="price-per-item--current">
                                      {{-
                                        'products.product.volume_pricing.price_at_each'
                                        | t: price: variant_price
                                      -}}
                                    </span>
                                  </dd>
                                </dl>
                              {%- else -%}
                                <span class="price-per-item--current">
                                  {{- 'products.product.volume_pricing.price_at_each' | t: price: variant_price -}}
                                </span>
                              {%- endif -%}
                            </div>
                          {%- endif -%}
                        </price-per-item>
                      {%- endif -%}
                    </div>
                    <div class="quantity__rules caption" id="Quantity-Rules-{{ section.id }}">
                      {%- if product.selected_or_first_available_variant.quantity_rule.increment > 1 -%}
                        <span class="divider">
                          {{-
                            'products.product.quantity.multiples_of'
                            | t: quantity: product.selected_or_first_available_variant.quantity_rule.increment
                          -}}
                        </span>
                      {%- endif -%}
                      {%- if product.selected_or_first_available_variant.quantity_rule.min > 1 -%}
                        <span class="divider">
                          {{-
                            'products.product.quantity.minimum_of'
                            | t: quantity: product.selected_or_first_available_variant.quantity_rule.min
                          -}}
                        </span>
                      {%- endif -%}
                      {%- if product.selected_or_first_available_variant.quantity_rule.max != null -%}
                        <span class="divider">
                          {{-
                            'products.product.quantity.maximum_of'
                            | t: quantity: product.selected_or_first_available_variant.quantity_rule.max
                          -}}
                        </span>
                      {%- endif -%}
                    </div>
                    {%- if product.quantity_price_breaks_configured? -%}
                      <volume-pricing class="parent-display" id="Volume-{{ section.id }}">
                        {%- if product.selected_or_first_available_variant.quantity_price_breaks.size > 0 -%}
                          <span class="caption-large">{{ 'products.product.volume_pricing.title' | t }}</span>
                          <ul class="list-unstyled">
                            <li>
                              <span>{{ product.selected_or_first_available_variant.quantity_rule.min }}+</span>
                              {%- assign price = product.selected_or_first_available_variant.price
                                | money_with_currency
                              -%}
                              <span data-text="{{ 'products.product.volume_pricing.price_at_each' | t: price: variant_price }}">
                                {{- 'sections.quick_order_list.each' | t: money: price -}}
                              </span>
                            </li>
                            {%- for price_break in product.selected_or_first_available_variant.quantity_price_breaks -%}
                              {%- assign price_break_price = price_break.price | money_with_currency -%}
                              <li class="{%- if forloop.index >= 3 -%}show-more-item hidden{%- endif -%}">
                                <span>
                                  {{- price_break.minimum_quantity -}}
                                  <span aria-hidden="true">+</span></span
                                >
                                <span data-text="{{ 'products.product.volume_pricing.price_at_each' | t: price: price_break_price }}">
                                  {{- 'sections.quick_order_list.each' | t: money: price_break_price -}}
                                </span>
                              </li>
                            {%- endfor -%}
                          </ul>
                          {%- if product.selected_or_first_available_variant.quantity_price_breaks.size >= 3 -%}
                            <show-more-button>
                              <button
                                class="button-show-more link underlined-link"
                                id="Show-More-{{ section.id }}"
                                type="button"
                              >
                                <span class="label-show-more label-text"
                                  ><span aria-hidden="true">+ </span>{{ 'products.facets.show_more' | t }}
                                </span>
                              </button>
                            </show-more-button>
                          {%- endif -%}
                        {%- endif -%}
                      </volume-pricing>
                    {%- endif -%}
              </div>
              </div>

            
            {%- when 'popup' -%}
            <style>
              #ProductPopup-{{ block.id }} {
                margin-top: {{ block.settings.padding_top }}px;
                margin-bottom: {{ block.settings.padding_bottom }}px;
              }
            </style>
              <modal-opener
                class="product-popup-modal__opener no-js-hidden quick-add-hidden align-{{ block.settings.text_alignment }}"
                data-modal="#PopupModal-{{ block.id }}"
                {{ block.shopify_attributes }}
              >
                <button
                  id="ProductPopup-{{ block.id }}"
                  class="{% if block.settings.link_style == 'button-outline' %}button button--outline{% endif %}{% if block.settings.link_style == 'button' %}button{% endif %}{% if block.settings.link_style == 'link--underlined' %}link--underlined{% endif %}{% if block.settings.link_style == 'text' %}product-popup-modal__button link text-{{ block.settings.text_size }} icon-{{ block.settings.link_icon }}{% endif %}"
                  type="button"
                  aria-haspopup="dialog"
                >
                  {% if block.settings.link_style == 'text' %}{% if block.settings.link_icon == 'info' %}{% render 'icon-info' %}{% endif %}{% if block.settings.link_icon == 'measurement' %}{% render 'icon-measurement' %}{% endif %}{% endif %}{{ block.settings.text | default: block.settings.page.title }}{% if block.settings.link_icon == 'arrow' and block.settings.link_style == 'text' %}{% render 'icon-caret' %}{% endif %}
                </button>
              </modal-opener>
            
            {%- when 'share' -%}
              {% assign share_url = product.selected_variant.url | default: product.url | prepend: request.origin %}
            <div class="product-share-component align-{{ block.settings.alignment }}{% if block.settings.show_label %} product-share-with-label{% endif %}" {{ block.shopify_attributes }}>
              {% render 'product-share-button',
                block: block,
                share_link: share_url
              %}
            </div>
            
            {%- when 'variant_picker' -%}
            {% unless product.has_only_default_variant %}
            <style>
            .product-form__input input[type=radio]+label {
              min-width: {{ block.settings.pill_min_width }}px;
            }
            .pill-layout--flex-grow .product-form__input .radio-options-wrapper input[type=radio]+label {
              min-width: 44px;
            }
            .product-form__input input[type=radio]+label.variant-picker-image {
              min-width: 53px !important;
            }
            .product-variant-picker-block .form__label {
              text-align: {{ block.settings.label_alignment }};
            }
            </style>
            <div class="product-variant-picker-block variant-picker-font-family--{{ block.settings.font_family }} variant-picker-{{ block.settings.picker_type }} variant-picker-label-alignment-{{ block.settings.label_alignment }}{% if block.settings.picker_type == 'button' %} pill-layout--{{ block.settings.pill_layout }} pill-alignment--{{ block.settings.pill_alignment }}{% endif %} swatch-shape-{{ block.settings.color_swatches_style }} swatch-size-{{ block.settings.color_swatch_size }} pill-selected-state--{{ block.settings.pill_selected_state }} minimal-selected-state--{{ block.settings.minimal_highlight_style }}">
            {% if block.settings.border_top %}
            <hr class="product-block-hr-top" />
            {% endif %}
            {% if block.settings.picker_title != blank %}
              <div class="variant-picker--block-title">{{ block.settings.picker_title | escape }}</div>
            {% endif %}

            {% if block.settings.use_color_swatches %}
              {% assign swatches = block.settings.color_swatches_array | strip | newline_to_br | strip_newlines | split: "<br />"  %}
              {% assign visual_variants = block.settings.visual_variants_array | split: ', '  %}
              
              {% for swatch in swatches %}
              <style>
              .picker-swatch-{{ swatch | split: " - " | first | handleize }} {
                background: {{ swatch | split: " - " | last }} !important;
              }  
              </style>
              {% endfor %}
            {% endif %}

            {% assign thumbnail_variants = block.settings.thumbnail_variants_label %}
            {% if block.settings.use_color_swatches %}
              {% assign visual_variants = block.settings.visual_variants_array | split: ', '  %}
            {% endif %}
              {% render 'product-variant-picker', 
                product: product, 
                block: block, 
                product_form_id: product_form_id, 
                labels: block.settings.show_labels, 
                pill_threshold: block.settings.pill_threshold,
                pill_options_display: block.settings.pill_additional_options_display, 
                show_variant_images: block.settings.use_variant_images, 
                thumbnail_variants: thumbnail_variants, 
                visual_variants: visual_variants, 
                swatches: block.settings.use_color_swatches, 
                swatch_style: block.settings.color_swatches_style, 
                swatch_size: block.settings.color_swatch_size, 
                swatch_label_position: block.settings.swatch_label_position
              %}
            {% if block.settings.border_bottom %}
            <hr class="product-block-hr-bottom" />
            {% endif %}
            </div>
            {% endunless %}

            {%- when 'icon_text_list' -%}
  {% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

  {% style %}
    .icon-text-list-{{ ai_gen_id }} {
      display: flex;
      flex-direction: column;
      gap: {{ block.settings.spacing_between_items }}px;
      padding-top: {{ block.settings.padding_top }}px;
      padding-right: {{ block.settings.padding_right }}px;
      padding-bottom: {{ block.settings.padding_bottom }}px;
      padding-left: {{ block.settings.padding_left }}px;
      background-color: {{ block.settings.background_color }};
      border-radius: {{ block.settings.border_radius }}px;
    }

    .icon-text-item-{{ ai_gen_id }} {
      display: flex;
      align-items: {{ block.settings.vertical_alignment }};
      gap: {{ block.settings.icon_text_spacing }}px;
    }

    .icon-wrapper-{{ ai_gen_id }} {
      flex-shrink: 0;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .icon-wrapper-1-{{ ai_gen_id }} {
      width: {{ block.settings.icon_1_size }}px;
      height: {{ block.settings.icon_1_size }}px;
    }

    .icon-wrapper-2-{{ ai_gen_id }} {
      width: {{ block.settings.icon_2_size }}px;
      height: {{ block.settings.icon_2_size }}px;
    }

    .icon-wrapper-3-{{ ai_gen_id }} {
      width: {{ block.settings.icon_3_size }}px;
      height: {{ block.settings.icon_3_size }}px;
    }

    .icon-wrapper-4-{{ ai_gen_id }} {
      width: {{ block.settings.icon_4_size }}px;
      height: {{ block.settings.icon_4_size }}px;
    }

    .icon-wrapper-5-{{ ai_gen_id }} {
      width: {{ block.settings.icon_5_size }}px;
      height: {{ block.settings.icon_5_size }}px;
    }

    .icon-wrapper-{{ ai_gen_id }} img,
    .icon-wrapper-{{ ai_gen_id }} svg {
      width: 100%;
      height: 100%;
      object-fit: contain;
    }

    .icon-svg-{{ ai_gen_id }} {
      color: {{ block.settings.icon_color }};
      fill: {{ block.settings.icon_color }};
      width: 100%;
      height: 100%;
    }

    .text-wrapper-{{ ai_gen_id }} {
      flex-grow: 1;
      color: {{ block.settings.text_color }};
      font-size: {{ block.settings.text_size }}px;
    }

    @media screen and (max-width: 749px) {
      .icon-text-list-{{ ai_gen_id }} {
        padding-top: {{ block.settings.padding_top | divided_by: 1.5 }}px;
        padding-right: {{ block.settings.padding_right | divided_by: 1.5 }}px;
        padding-bottom: {{ block.settings.padding_bottom | divided_by: 1.5 }}px;
        padding-left: {{ block.settings.padding_left | divided_by: 1.5 }}px;
        gap: {{ block.settings.spacing_between_items | divided_by: 1.5 }}px;
      }

      .icon-wrapper-1-{{ ai_gen_id }} {
        width: {{ block.settings.mobicon_1_size | times: 0.8 }}px;
        height: {{ block.settings.mobicon_1_size | times: 0.8 }}px;
      }

      .icon-wrapper-2-{{ ai_gen_id }} {
        width: {{ block.settings.mobicon_2_size | times: 0.8 }}px;
        height: {{ block.settings.mobicon_2_size | times: 0.8 }}px;
      }

      .icon-wrapper-3-{{ ai_gen_id }} {
        width: {{ block.settings.mobicon_3_size | times: 0.8 }}px;
        height: {{ block.settings.mobicon_3_size | times: 0.8 }}px;
      }

      .icon-wrapper-4-{{ ai_gen_id }} {
        width: {{ block.settings.mobicon_4_size | times: 0.8 }}px;
        height: {{ block.settings.mobicon_4_size | times: 0.8 }}px;
      }

      .icon-wrapper-5-{{ ai_gen_id }} {
        width: {{ block.settings.mobicon_5_size | times: 0.8 }}px;
        height: {{ block.settings.mobicon_5_size | times: 0.8 }}px;
      }

      .text-wrapper-{{ ai_gen_id }} {
        font-size: {{ block.settings.mobtext_size | times: 0.9 }}px;
      }
    }
  {% endstyle %}

  <div class="icon-text-list-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
    {% for i in (1..5) %}
      {% assign icon_type_key = 'icon_' | append: i | append: '_type' %}
      {% assign icon_type = block.settings[icon_type_key] %}

      {% assign icon_image_key = 'icon_' | append: i | append: '_image' %}
      {% assign icon_image = block.settings[icon_image_key] %}

      {% assign icon_svg_key = 'icon_' | append: i | append: '_svg' %}
      {% assign icon_svg = block.settings[icon_svg_key] %}

      {% assign icon_custom_svg_key = 'icon_' | append: i | append: '_custom_svg' %}
      {% assign icon_custom_svg = block.settings[icon_custom_svg_key] %}

      {% assign text_key = 'text_' | append: i %}
      {% assign text = block.settings[text_key] %}

      {% if icon_type != blank and text != blank %}
        <div class="icon-text-item-{{ ai_gen_id }}">
