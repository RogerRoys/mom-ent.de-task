<script>
function htmlEscape(str) {
  return str.replace('/&/g', '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;')
            .replace(/'/g, '&#39;');
}

// Function to add an item to the Recently Viewed Items
function addRecentItem() {
    var productData = {
        productID: "{{ product.id }}",
        productTitle: "{{ product.title | escape }}",
        productVendor: "{{ product.vendor }}",
        productImg: "{{ product.featured_media | image_url: width: 600 }}",
        productPrice: "{{ product.selected_or_first_available_variant.price | money }}",
        productHasCompareAtPrice: "{% if product.selected_or_first_available_variant.compare_at_price > product.selected_or_first_available_variant.price %}true{% else %}false{% endif %}",
        productCompareAtPrice: "{{ product.selected_or_first_available_variant.compare_at_price | money }}",
        productUrl: "{{ product.url }}"
    };

    var RecentlyViewedItemsList = getRecentlist();

    RecentlyViewedItemsList = RecentlyViewedItemsList.filter(function(item) {
      return item.productUrl !== productData.productUrl;
    });

    RecentlyViewedItemsList.push(productData);

    if (RecentlyViewedItemsList.length > 8) {
      RecentlyViewedItemsList.shift();
    }

    saveRecentlist(RecentlyViewedItemsList);

}

// Function to retrieve the Recently Viewed Items from local storage
function getRecentlist() {
  var RecentlyViewedItemsList = localStorage.getItem("RecentlyViewedItemsList");
  if (RecentlyViewedItemsList === null) {
    return []; // Return an empty array if RecentlyViewedItemsList doesn't exist
  }
  return JSON.parse(RecentlyViewedItemsList);
}

// Function to save the RecentlyViewedItemsList to local storage
function saveRecentlist(RecentlyViewedItemsList) {
  localStorage.setItem("RecentlyViewedItemsList", JSON.stringify(RecentlyViewedItemsList));
}

// Add current product to Recently Viewed when the page loads
addRecentItem();

</script>
  
