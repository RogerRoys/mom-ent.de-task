{% if section.settings.enable_sticky_buttons_desktop %}

<style>
@media only screen and (min-width: 950px) {
  .product-buy-buttons-wrapper.stick-now .product-form {
    padding-top: {{ section.settings.sticky_buttons_desktop_padding_vertical }}px;
    padding-bottom: {{ section.settings.sticky_buttons_desktop_padding_vertical }}px;
    padding-left: {{ section.settings.sticky_buttons_desktop_padding_vertical }}px;
    padding-right: {{ section.settings.sticky_buttons_desktop_padding_vertical }}px;
    box-shadow: 0px 0px 12px 0px rgba(0,0,0,{{ section.settings.sticky_buttons_shadow | divided_by: 100.0 }});
  }
}
</style>

<script>
document.addEventListener('DOMContentLoaded', function () {
  const buyButtonsWrapper = document.querySelector('.product-buy-buttons-wrapper');

  if (!buyButtonsWrapper) return;

  const threshold = 150;
  const fadeDelay = 200;
  const fadeDuration = 300;

  let isSticky = false;
  let fadeInTimeout = null;
  let fadeOutTimeout = null;

  function getReserveHeight() {
    const styles = window.getComputedStyle(buyButtonsWrapper);
    const marginBottom = (parseFloat(styles.marginBottom) || 0);
    return buyButtonsWrapper.offsetHeight;
  }

  // The floating bar is the real product form, moved. Anything an app injects
  // into that form — the bundle selector, upsells — rides along and is shown a
  // second time inside the bar. gift-note/section CSS hides those, but an app
  // can out-specify a stylesheet with an inline style, so enforce it here too.
  // Nothing that contains the submit button is ever touched.
  function trimStickyBar(sticking) {
    const productForm = buyButtonsWrapper.querySelector('.product-form');
    if (!productForm) return;

    const innerForm = productForm.querySelector('form');
    const buttons = productForm.querySelector('.product-form__buttons');
    const candidates = [
      ...productForm.children,
      ...(innerForm ? innerForm.children : []),
      ...(buttons ? buttons.children : [])
    ];

    candidates.forEach(function (el) {
      if (el === innerForm || el === buttons) return;
      if (el.querySelector('.product-form__submit')) return;
      if (el.matches('.product-sticky-title, .product-form__error-message-wrapper')) return;
      if (el.matches('.product-form__submit, .shopify-payment-button')) return;

      if (sticking) {
        if (el.dataset.stickyTrimmed) return;
        el.dataset.stickyTrimmed = el.style.getPropertyPriority('display') === 'important'
          ? 'important:' + el.style.display
          : 'normal:' + el.style.display;
        el.style.setProperty('display', 'none', 'important');
        return;
      }

      if (!el.dataset.stickyTrimmed) return;
      const parts = el.dataset.stickyTrimmed.split(':');
      const value = parts.slice(1).join(':');
      el.style.removeProperty('display');
      if (value) el.style.setProperty('display', value, parts[0] === 'important' ? 'important' : '');
      delete el.dataset.stickyTrimmed;
    });
  }

  function updateSticky() {

    if (window.innerWidth < 950) {
      buyButtonsWrapper.style.minHeight = '';
      isSticky = false;
      return;
    }

    const shouldStick = buyButtonsWrapper.getBoundingClientRect().top <= -threshold;

    if (shouldStick && !isSticky) {
      isSticky = true;

      clearTimeout(fadeOutTimeout);
      clearTimeout(fadeInTimeout);

      buyButtonsWrapper.style.minHeight = `${getReserveHeight()}px`;
      buyButtonsWrapper.classList.add('stick-now');
      buyButtonsWrapper.classList.remove('stick-visible');
      trimStickyBar(true);

      fadeInTimeout = setTimeout(function () {
        if (isSticky) {
          // again, in case an app injected into the form in the meantime
          trimStickyBar(true);
          buyButtonsWrapper.classList.add('stick-visible');
        }
      }, fadeDelay);
    }

    if (!shouldStick && isSticky) {
      isSticky = false;

      clearTimeout(fadeInTimeout);
      buyButtonsWrapper.classList.remove('stick-visible');

      clearTimeout(fadeOutTimeout);
      fadeOutTimeout = setTimeout(function () {
        if (!isSticky) {
          buyButtonsWrapper.classList.remove('stick-now');
          buyButtonsWrapper.style.minHeight = '';
          trimStickyBar(false);
        }
      }, 0);
    }
  }

  window.addEventListener('scroll', updateSticky, { passive: true });
  window.addEventListener('resize', function () {
    if (isSticky) {
      buyButtonsWrapper.style.minHeight = `${getReserveHeight()}px`;
    }
    updateSticky();
  });

  updateSticky();
});
</script>
{% endif %}


