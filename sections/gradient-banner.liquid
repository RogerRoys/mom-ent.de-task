<style>
@media only screen and (max-width: 750px) {
  .newh {
font-size:30px !important;
    margin-bottom:10px !important;
  }

    .newp {
font-size:20px !important;
      width: 70% !important;
          
  }
}

  
</style>


{% schema %}
{
  "name": "Gradient Banner",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "SHOP ALL"
    },
    {
      "type": "inline_richtext",
      "id": "body_text",
      "label": "Body Text",
      "default": "Thoughtfully created by <i>mothers, for mothers</i>"
    },
    {
      "type": "color_background",
      "id": "background_gradient",
      "label": "Background Gradient",
      "default": "linear-gradient(135deg, #C1493B, #8D81A8)"
    },
    {
      "type": "range",
      "id": "top_padding",
      "label": "Top Padding",
      "default": 40,
      "min": 10,
      "max": 100,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "bottom_padding",
      "label": "Bottom Padding",
      "default": 40,
      "min": 10,
      "max": 100,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "heading_font_size",
      "label": "Heading Font Size",
      "default": 24,
      "min": 12,
      "max": 70,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "body_font_size",
      "label": "Body Font Size",
      "default": 18,
      "min": 12,
      "max": 50,
      "unit": "px"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    }
  ],
  "presets": [
    {
      "name": "Gradient Banner",
      "category": "Custom"
    }
  ]
}
{% endschema %}

<div class="gradient-banner"
     style="
     background: {{ section.settings.background_gradient }};
     padding-top: {{ section.settings.top_padding }}px;
     padding-bottom: {{ section.settings.bottom_padding }}px;
     text-align: {{ section.settings.text_alignment }};
     color: white;
     display: flex;
     flex-direction: column;
     justify-content: center;
     align-items: {{ section.settings.text_alignment }};
     ">
    
    <h2 class="newh" style="font-size: {{ section.settings.heading_font_size }}px; margin-bottom:30px;">
        {{ section.settings.heading }}
    </h2>
    
<p class="newp" style="font-size: {{ section.settings.body_font_size }}px;">
  Want more expert tips, upcoming webinars, and wellness events?<br>
  Follow us on social media and subscribe to our newsletter to be the first to know about new content and exclusive opportunities!
</p>
</div>
