          }
        },
        "collapsible_tab_fDPaRf": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Nährwerte",
            "content": "<p>Tagesportion (2 Gummies) enthält:<br/>Ashwagandha KSM-66® Extrakt — 300 mg<br/>davon Withanolide — 15 mg<br/>Löwenmähne-Pilzextrakt — 240 mg<br/>davon Beta-Glucane — 48 mg<br/>Rhodiola-rosea-Wurzelextrakt DER 4:1 — 80 mg<br/>davon Salidroside — 0,8 mg<br/>Vitamin B6 (Pyridoxinhydrochlorid) — 0,9 mg (64%*)</p><p><br/>*RM = Referenzmenge</p>",
